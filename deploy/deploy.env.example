# ===========================================================================
# Deployment target. Copy to deploy/deploy.env and fill in.
# deploy/deploy.env holds secrets and is git-ignored.
# Switching to a new VPS means editing this file and nothing else.
# ===========================================================================

# ---- Server ----
SSH_HOST=116.118.6.61
SSH_USER=root
SSH_PORT=22
# Leave empty to use your default SSH agent/key.
SSH_KEY="$HOME/.ssh/event_vps"

# ---- Site ----
DOMAIN=event.vhdcorp.com
APP_DIR=/root/event-mgmt
APP_NAME=event            # prefix for the pm2 processes and the nginx site file
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Ports (must be free on the server) ----
API_PORT=8090
WEB_PORT=3002

# ---- Database ----
# Uses the PostgreSQL already installed on the server. The script creates the
# role and database if they do not exist.
DB_NAME=event_db
DB_USER=event_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Application secrets ----
JWT_SECRET=CHANGE_ME_long_random_string
ADMIN_EMAIL=admin@vhdcorp.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- TLS ----
# Cloudflare origin certificate already present on this server. With Cloudflare
# SSL mode "Full", the certificate does not have to match the subdomain.
SSL_CERT=/etc/nginx/ssl/origin.crt
SSL_KEY=/etc/nginx/ssl/origin.key

# ---- Seed ----
# true  -> insert the demo event (speakers, agenda, articles) on first deploy
# false -> deploy with an empty database, ready for real content
SEED_DEMO=true
