# Browser-facing API base. In production this is the public site origin so
# requests go through nginx on the same domain.
NEXT_PUBLIC_API_URL=http://localhost:8090
# Server-side fetches inside the container/VPS talk to the Go service directly.
API_INTERNAL_URL=http://127.0.0.1:8090
NEXT_PUBLIC_SITE_URL=http://localhost:3002
